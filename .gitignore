# Python
.env
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type-checker & linter caches
.mypy_cache/
.ruff_cache/

# App runtime output
output/

# Streamlit secrets
.streamlit/secrets.toml

# Pre-rendered docs (generated from source)
docs/PROJECT.html
docs/PROJECT.pdf

# Playwright MCP session artifacts (console logs, page snapshots, screenshots)
.playwright-mcp/

# Debug / verification screenshots generated during development
/verify-*.png
/fix*.png
/final-*.png
/page-*.png
/*.png

# OS artifacts
Thumbs.db
desktop.ini
.DS_Store

# Editor temp files
*.swp
*~
.idea/
.vscode/*.local.json

# Local Codespace SSH key material (never commit)
.codespaces/
